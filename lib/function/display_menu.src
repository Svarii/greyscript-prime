

display_menu = function(menuList, selectedItem, highlightcolor = "#FFFF002C", textColor = "#FFFFFF", windowSize = 6)
    locals.outputMenu = []
    for menuItem in locals.menuList
        if locals.selectedItem == __menuItem_idx then
            if locals.textColor == null then
                locals.outputMenu.push(locals.menuItem.mark(locals.highlightcolor))
            else
                locals.outputMenu.push(locals.menuItem.color(locals.textColor).mark(locals.highlightcolor))
            end if
        else
            locals.outputMenu.push(locals.menuItem)
        end if
    end for
    return locals.outputMenu[locals.selectedItem:(locals.selectedItem + locals.windowSize)]
end function





keepAlive = true
myMenu = ["item 1", "item2", "item3", "item4"]
menuSelection = 0

menu_select = function(menuSelection, myMenu)
    return user_navigation(menuSelection, user_input("", false, true)).clamp(0, (myMenu.len - 1))
end function

while not userInput ==  "LeftArrow"
    clear_screen
    menu = display_menu(myMenu, menuSelection)
    for line in menu
        print line
    end for
    menuSelection = menu_select(menuSelection, myMenu)
    //menuSelection = (user_navigation(menuSelection, user_input("", false, true))).clamp(0, (myMenu.len - 1))
end while 